# =====================================================================
# .gitignore for Power BI projects
# =====================================================================
 
# -----------------------------
# Power BI temporary and cache files
# -----------------------------
*.pbix.tmp
*.pbit.tmp
~$*.pbix
~$*.pbit
*.lock
 
# -----------------------------
# Power BI Desktop temporary folders
# -----------------------------
TempSaves/
Cache/
 
# -----------------------------
# Operating system files
# -----------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
 
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
 
# Linux
*~
.fuse_hidden*
.directory
.Trash-*
 
# -----------------------------
# Editor and IDE files
# -----------------------------
.vscode/
.idea/
*.swp
*.swo
*.bak
*.tmp
 
# -----------------------------
# Local data downloads (if any)
# -----------------------------
# The project loads data from URLs directly, but if you ever download
# local CSV copies for testing, ignore them
data/local/
data/downloads/
*.csv.bak
 
# -----------------------------
# Logs and output
# -----------------------------
*.log
output/
exports/
 
# -----------------------------
# Python / virtual environments (for any helper scripts)
# -----------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
 
# -----------------------------
# Sensitive credentials (never commit !)
# -----------------------------
.env
.env.local
credentials.json
secrets.json
config.local.*

